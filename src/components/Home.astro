---
/** 首頁：兩種語言共用同一個版面，內容來自 src/data/{zh,en}.ts */
import BaseLayout from '../layouts/BaseLayout.astro';
import Profile from './Profile.astro';
import Overview from './Overview.astro';
import Projects from './Projects.astro';
import Publications from './Publications.astro';
import { content, type Locale } from '../data';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = content[locale];
const year = new Date().getFullYear();
const updated = new Date().toISOString().slice(0, 10);
---

<BaseLayout locale={locale}>
  <slot name="head" slot="head" />
  <main class="page">
    <Profile locale={locale} />
    <Overview locale={locale} />
    <Projects locale={locale} />
    <Publications locale={locale} />
    <footer class="muted">
      © {year} {c.name} · {c.ui.lastUpdated} {updated}
    </footer>
  </main>
</BaseLayout>

<style>
  footer {
    font-size: var(--fs-small);
    text-align: center;
  }
</style>
