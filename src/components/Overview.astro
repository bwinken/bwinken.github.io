---
/**
 * 概覽：經歷時間軸，下面接技能標籤（上下排列，不並排）。
 * 時間軸把工作和學歷合在一起，依開始年份由舊到新、由左到右排列；
 * 最右邊（目前的工作）欄位較寬。手機上改成直式，最新的在最上面。
 */
import { content, type Locale } from '../data';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = content[locale];
const startYear = (period: string) => Number(period.match(/\d{4}/)?.[0] ?? 0);

type Item = {
  kind: 'work' | 'edu';
  title: string;
  org: string;
  period: string;
  highlights?: string[];
  note?: string;
};

const items: Item[] = [
  ...c.experience.map((e) => ({ kind: 'work' as const, title: e.role, org: e.org, period: e.period, highlights: e.highlights })),
  ...c.education.map((e) => ({ kind: 'edu' as const, title: e.degree, org: e.school, period: e.period, note: e.note })),
].sort((a, b) => startYear(a.period) - startYear(b.period));

const columns = `repeat(${items.length - 1}, minmax(0, 1fr)) minmax(0, 1.8fr)`;
---

<section class="overview">
  <div>
    <h2 class="section-title">{c.ui.experience}</h2>
    <ol class="timeline" style={`grid-template-columns: ${columns}`}>
      {
        items.map((it, i) => (
          <li class:list={['item', it.kind, { current: i === items.length - 1 }]}>
            <span class="dot" aria-hidden="true" />
            <div class="when muted">
              {it.period}
              {it.kind === 'edu' && <span class="kind"> · {c.ui.education}</span>}
            </div>
            <div class="title">{it.title}</div>
            <div class="org">{it.org}</div>
            {it.note && <div class="note muted">{it.note}</div>}
            {it.highlights && it.highlights.length > 0 && (
              <ul class="highlights">
                {it.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ol>
  </div>

  <div>
    <h2 class="section-title">{c.ui.skills}</h2>
    <div class="skills">
      {
        c.skills.map((g) => (
          <div>
            <h3 class="group muted">{g.category}</h3>
            <ul class="tags">
              {g.items.map((s) => (
                <li>{s}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .overview {
    display: grid;
    gap: var(--space-5);
  }
  ol,
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* ---------- 時間軸：手機（直式，最新在上） ---------- */
  .timeline {
    display: flex;
    flex-direction: column-reverse;
  }
  .item {
    position: relative;
    margin-left: 6px;
    padding: 0 0 var(--space-4) 22px;
    border-left: 1px solid var(--line);
  }
  /* DOM 裡第一個（最舊）在畫面最下方，線到這裡結束 */
  .item:first-child {
    border-left-color: transparent;
    padding-bottom: 0;
  }
  .dot {
    position: absolute;
    left: -6px;
    top: 4px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    border: 2px solid var(--link);
    background: var(--bg);
  }
  .current .dot {
    background: var(--link);
  }
  .edu .dot {
    border-color: var(--muted);
  }
  .when {
    font-size: var(--fs-small);
    font-variant-numeric: tabular-nums;
  }
  .title {
    font-weight: 700;
  }
  .org,
  .note {
    font-size: var(--fs-meta);
  }
  .highlights {
    margin-top: var(--space-2);
    padding-left: 1.1em;
    list-style: disc;
    display: grid;
    gap: 2px;
    font-size: var(--fs-meta);
  }
  .highlights li::marker {
    color: var(--muted);
  }

  /* ---------- 時間軸：寬螢幕（由左到右） ---------- */
  @media (min-width: 720px) {
    .timeline {
      display: grid;
      gap: 0 var(--space-4);
    }
    .item,
    .item:first-child {
      margin-left: 0;
      padding: 26px 0 0;
      border-left: 0;
    }
    /* 橫線：從每個節點延伸到下一個節點 */
    .item::after {
      content: '';
      position: absolute;
      top: 7px;
      left: 0;
      right: calc(-1 * var(--space-4));
      height: 1px;
      background: var(--line);
    }
    .item:last-child::after {
      right: 0;
    }
    .dot {
      left: 0;
      top: 2px;
      z-index: 1;
    }
    .highlights {
      font-size: var(--fs-meta);
    }
  }

  /* ---------- 技能標籤 ---------- */
  .skills {
    display: grid;
    gap: var(--space-3);
  }
  .group {
    font-size: var(--fs-small);
    margin-bottom: 6px;
  }
  /* 寬螢幕：分類名稱在左、標籤在右 */
  @media (min-width: 480px) {
    .skills > div {
      display: grid;
      grid-template-columns: 96px minmax(0, 1fr);
      gap: 0 var(--space-3);
      align-items: baseline;
    }
    .group {
      text-align: right;
      margin-bottom: 0;
    }
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tags li {
    font-size: var(--fs-small);
    line-height: 1.5;
    padding: 2px 8px;
    border: 1px solid var(--line);
    border-radius: 3px;
    background: var(--bg);
  }
</style>
