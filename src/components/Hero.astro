---
import { content, shared, type Locale } from '../data';
import EmailLink from './EmailLink.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = content[locale];
---

<section class="hero" id="about">
  <div class="top">
    {
      shared.avatar ? (
        <img class="avatar" src={shared.avatar} alt={c.name} width="96" height="96" />
      ) : (
        <div class="avatar placeholder" aria-hidden="true">
          {shared.initials}
        </div>
      )
    }
    <div>
      <h1>{c.name}</h1>
      <p class="headline">{c.headline}</p>
      <p class="muted location">{c.location}</p>
    </div>
  </div>

  <div class="about">
    {c.about.map((p) => <p>{p}</p>)}
  </div>

  <div class="cta no-print">
    {
      c.resume && (
        <a class="btn btn-primary" href={c.resume} target="_blank" rel="noopener">
          {c.ui.downloadResume}
        </a>
      )
    }
    <EmailLink class={c.resume ? 'btn' : 'btn btn-primary'} label={c.ui.contactMe} />
    {
      shared.links.map((l) => (
        <a class="btn" href={l.href} target="_blank" rel="noopener me">
          {l.label}
        </a>
      ))
    }
  </div>
</section>

<style>
  .hero {
    padding: 56px 0 40px;
  }
  .top {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 24px;
  }
  .avatar {
    flex: none;
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--border);
  }
  .placeholder {
    display: grid;
    place-items: center;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 1.8rem;
    font-weight: 700;
  }
  h1 {
    font-size: clamp(1.7rem, 5vw, 2.3rem);
  }
  .headline {
    margin: 4px 0 0;
    font-size: 1.08rem;
  }
  .location {
    margin: 2px 0 0;
    font-size: 0.92rem;
  }
  .about p {
    margin: 0 0 12px;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }
  @media (max-width: 480px) {
    .top {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
