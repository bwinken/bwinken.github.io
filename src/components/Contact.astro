---
import { content, shared, type Locale } from '../data';
import EmailLink from './EmailLink.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = content[locale];
---

<section class="section" id="contact">
  <h2>{c.ui.sections.contact}</h2>
  <p>{c.ui.contactIntro}</p>
  <ul class="list">
    <li>
      <span class="label">Email</span>
      <EmailLink label={c.ui.emailMe} showAddress />
    </li>
    {
      shared.links.map((l) => (
        <li>
          <span class="label">{l.label}</span>
          <a href={l.href} target="_blank" rel="noopener me">
            {l.href.replace(/^https?:\/\/(www\.)?/, '')}
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  p {
    margin: 0 0 16px;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .list li {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .label {
    min-width: 80px;
    color: var(--muted);
  }
</style>
