---
import { content, locales, shared, type Locale } from '../data';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { ui, name } = content[locale];
const other: Locale = locale === 'zh' ? 'en' : 'zh';
const navItems = [
  { href: '#about', label: ui.nav.about },
  { href: '#experience', label: ui.nav.experience },
  { href: '#projects', label: ui.nav.projects },
  { href: '#skills', label: ui.nav.skills },
  { href: '#contact', label: ui.nav.contact },
];
---

<header class="site-header no-print">
  <div class="container bar">
    <a class="brand" href={locales[locale].path}>{shared.initials}<span class="sr-only"> – {name}</span></a>
    <nav aria-label="Main">
      <ul>
        {navItems.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
    <div class="actions">
      <a class="lang" href={locales[other].path} hreflang={locales[other].htmlLang} data-lang-switch={other}>
        {ui.switchLanguage}
      </a>
      <button class="theme" type="button" aria-label={ui.toggleTheme} title={ui.toggleTheme} data-theme-toggle>
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
      </button>
    </div>
  </div>
</header>

<script>
  // 深淺色切換：記住使用者的選擇
  const root = document.documentElement;
  const isDark = () =>
    root.dataset.theme === 'dark' ||
    (!root.dataset.theme && window.matchMedia('(prefers-color-scheme: dark)').matches);

  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });

  // 手動切換語言時記住，之後首頁就不會再自動導向
  document.querySelector('[data-lang-switch]')?.addEventListener('click', (e) => {
    const lang = (e.currentTarget as HTMLElement).dataset.langSwitch;
    try {
      if (lang) localStorage.setItem('lang', lang);
    } catch {}
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 16px;
    height: 56px;
  }
  .brand {
    font-weight: 700;
    color: var(--text);
    letter-spacing: 0.02em;
  }
  .brand:hover {
    text-decoration: none;
  }
  nav {
    flex: 1;
    overflow-x: auto;
    scrollbar-width: none;
  }
  nav ul {
    display: flex;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
    white-space: nowrap;
  }
  nav a {
    color: var(--muted);
    font-size: 0.92rem;
  }
  nav a:hover {
    color: var(--text);
    text-decoration: none;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .lang {
    font-size: 0.88rem;
    padding: 4px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text);
  }
  .lang:hover {
    border-color: var(--accent);
    text-decoration: none;
  }
  .theme {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }
  .icon-moon {
    display: none;
  }
  :global(:root[data-theme='dark']) .icon-sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .icon-moon {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .icon-sun {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .icon-moon {
      display: block;
    }
  }
  /* 手機上隱藏導覽列，保留語言與主題切換 */
  @media (max-width: 560px) {
    nav {
      display: none;
    }
    .actions {
      margin-left: auto;
    }
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
