---
import { content, type Locale } from '../data';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = content[locale];
---

<section class="section" id="experience">
  <h2>{c.ui.sections.experience}</h2>
  <ol class="timeline">
    {
      c.experience.map((job) => (
        <li>
          <div class="head">
            <h3>
              {job.role} <span class="at">· {job.company}</span>
            </h3>
            <span class="muted period">
              {job.period}
              {job.location && ` · ${job.location}`}
            </span>
          </div>
          <ul>
            {job.highlights.map((h) => (
              <li>{h}</li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>

  {
    c.education.length > 0 && (
      <>
        <h2 class="sub">{c.ui.sections.education}</h2>
        <ul class="education">
          {c.education.map((e) => (
            <li>
              <div class="head">
                <h3>
                  {e.degree} <span class="at">· {e.school}</span>
                </h3>
                <span class="muted period">{e.period}</span>
              </div>
              {e.note && <p class="muted">{e.note}</p>}
            </li>
          ))}
        </ul>
      </>
    )
  }
</section>

<style>
  .timeline,
  .education {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 24px;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 4px 16px;
  }
  h3 {
    font-size: 1.05rem;
  }
  .at {
    font-weight: 500;
    color: var(--muted);
  }
  .period {
    font-size: 0.88rem;
    white-space: nowrap;
  }
  .timeline ul {
    margin: 8px 0 0;
    padding-left: 1.2em;
  }
  .timeline ul li {
    margin-bottom: 4px;
  }
  .sub {
    font-size: 1.35rem;
    margin: 40px 0 20px;
  }
  .education p {
    margin: 4px 0 0;
  }
</style>
