---
import { content, type Locale } from '../data';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = content[locale];
---

<section class="section" id="skills">
  <h2>{c.ui.sections.skills}</h2>
  <dl>
    {
      c.skills.map((g) => (
        <div class="row">
          <dt>{g.category}</dt>
          <dd>
            <ul class="tags">
              {g.items.map((s) => (
                <li>{s}</li>
              ))}
            </ul>
          </dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  dl {
    margin: 0;
    display: grid;
    gap: 14px;
  }
  .row {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 8px 16px;
    align-items: start;
  }
  dt {
    font-weight: 600;
  }
  dd {
    margin: 0;
    padding-top: 2px;
  }
  @media (max-width: 480px) {
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>
