---
/** 專案：左邊示意圖、右邊說明；highlight 的項目會加上淡黃底色 */
import { content, type Locale } from '../data';
import ProjectFigure from './ProjectFigure.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = content[locale];
---

<section>
  <h2 class="section-title">{c.ui.projects}</h2>
  {c.projectsLead && <p class="lead">{c.projectsLead}</p>}
  <div class="list">
    {
      c.projects.map((p) => (
        <article class:list={['project', { highlight: p.highlight }]}>
          <ProjectFigure name={p.figure} />
          <div>
            {p.link ? (
              <a class="title" href={p.link} target="_blank" rel="noopener">
                {p.title}
              </a>
            ) : (
              <span class="title">{p.title}</span>
            )}
            <div class="meta muted">{p.meta}</div>
            <p>{p.description}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .lead {
    margin-bottom: var(--space-3);
  }
  .list {
    display: grid;
    gap: var(--space-2);
  }
  .project {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr);
    gap: var(--space-3);
    align-items: start;
    padding: var(--space-3) 10px;
  }
  @media (min-width: 560px) {
    .project {
      grid-template-columns: 170px minmax(0, 1fr);
      gap: var(--space-4);
      align-items: center;
    }
  }
  .highlight {
    background: var(--highlight);
  }
  .title {
    color: var(--link);
    font-weight: 700;
  }
  .meta {
    font-size: var(--fs-meta);
  }
  p {
    margin-top: var(--space-1);
  }
</style>
